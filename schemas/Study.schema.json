{
  "$defs": {
    "ExecutionPlan": {
      "additionalProperties": false,
      "description": "Method-specific execution configuration embedded in a Study.",
      "properties": {
        "blockers": {
          "items": {
            "type": "string"
          },
          "title": "Blockers",
          "type": "array"
        },
        "declared_readiness": {
          "anyOf": [
            {
              "enum": [
                "draft",
                "local",
                "public",
                "blocked"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared Readiness"
        },
        "entrypoint": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entrypoint"
        },
        "expected_outputs": {
          "items": {
            "type": "string"
          },
          "title": "Expected Outputs",
          "type": "array"
        },
        "method_id": {
          "title": "Method Id",
          "type": "string"
        },
        "profile_ids": {
          "items": {
            "type": "string"
          },
          "title": "Profile Ids",
          "type": "array"
        },
        "requires": {
          "$ref": "#/$defs/Requirements"
        }
      },
      "required": [
        "method_id"
      ],
      "title": "ExecutionPlan",
      "type": "object"
    },
    "Requirements": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "items": {
            "type": "string"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        }
      },
      "title": "Requirements",
      "type": "object"
    },
    "StudyExecution": {
      "additionalProperties": false,
      "properties": {
        "plans": {
          "items": {
            "$ref": "#/$defs/ExecutionPlan"
          },
          "title": "Plans",
          "type": "array"
        }
      },
      "title": "StudyExecution",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Artifact Ids",
      "type": "array"
    },
    "blockers": {
      "items": {
        "type": "string"
      },
      "title": "Blockers",
      "type": "array"
    },
    "claim_ids": {
      "items": {
        "type": "string"
      },
      "title": "Claim Ids",
      "type": "array"
    },
    "completion_criteria": {
      "minLength": 1,
      "title": "Completion Criteria",
      "type": "string"
    },
    "contributors": {
      "items": {
        "type": "string"
      },
      "title": "Contributors",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "pattern": "^[a-z]+:[A-Za-z0-9_.-]+$",
      "title": "Created By",
      "type": "string"
    },
    "execution": {
      "$ref": "#/$defs/StudyExecution"
    },
    "goal": {
      "minLength": 1,
      "title": "Goal",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "known_limitations": {
      "items": {
        "type": "string"
      },
      "title": "Known Limitations",
      "type": "array"
    },
    "lifecycle": {
      "enum": [
        "draft",
        "planned",
        "active",
        "completed",
        "blocked",
        "superseded"
      ],
      "title": "Lifecycle",
      "type": "string"
    },
    "method_ids": {
      "items": {
        "type": "string"
      },
      "title": "Method Ids",
      "type": "array"
    },
    "motivation": {
      "minLength": 1,
      "title": "Motivation",
      "type": "string"
    },
    "question_ids": {
      "items": {
        "type": "string"
      },
      "title": "Question Ids",
      "type": "array"
    },
    "result_ids": {
      "items": {
        "type": "string"
      },
      "title": "Result Ids",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "id",
    "created_by",
    "created_at",
    "title",
    "lifecycle",
    "goal",
    "motivation",
    "completion_criteria"
  ],
  "title": "Study",
  "type": "object"
}
