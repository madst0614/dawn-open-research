{
  "additionalProperties": false,
  "properties": {
    "claim_type": {
      "enum": [
        "proposition",
        "interpretation",
        "definition"
      ],
      "title": "Claim Type",
      "type": "string"
    },
    "contributors": {
      "items": {
        "type": "string"
      },
      "title": "Contributors",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "pattern": "^[a-z]+:[A-Za-z0-9_.-]+$",
      "title": "Created By",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "minLength": 1,
      "title": "Scope",
      "type": "string"
    },
    "statement": {
      "minLength": 1,
      "title": "Statement",
      "type": "string"
    },
    "status": {
      "enum": [
        "proposed",
        "tentative",
        "supported",
        "robust",
        "disputed",
        "limited",
        "contradicted",
        "superseded"
      ],
      "title": "Status",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "id",
    "created_by",
    "created_at",
    "title",
    "statement",
    "claim_type",
    "scope",
    "status"
  ],
  "title": "Claim",
  "type": "object"
}
