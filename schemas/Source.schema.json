{
  "additionalProperties": false,
  "properties": {
    "contributors": {
      "items": {
        "type": "string"
      },
      "title": "Contributors",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "pattern": "^[a-z]+:[A-Za-z0-9_.-]+$",
      "title": "Created By",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_statement": {
      "title": "Source Statement",
      "type": "string"
    },
    "source_type": {
      "enum": [
        "paper",
        "book",
        "dataset",
        "repository",
        "documentation",
        "benchmark",
        "other"
      ],
      "title": "Source Type",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "uri": {
      "title": "Uri",
      "type": "string"
    }
  },
  "required": [
    "id",
    "created_by",
    "created_at",
    "title",
    "source_type",
    "uri",
    "source_statement"
  ],
  "title": "Source",
  "type": "object"
}
