{
  "additionalProperties": false,
  "properties": {
    "asserted_at": {
      "format": "date-time",
      "title": "Asserted At",
      "type": "string"
    },
    "asserted_by": {
      "title": "Asserted By",
      "type": "string"
    },
    "contributors": {
      "items": {
        "type": "string"
      },
      "title": "Contributors",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "pattern": "^[a-z]+:[A-Za-z0-9_.-]+$",
      "title": "Created By",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "relation_class": {
      "enum": [
        "semantic",
        "provenance"
      ],
      "title": "Relation Class",
      "type": "string"
    },
    "relation_type": {
      "title": "Relation Type",
      "type": "string"
    },
    "review_notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Notes"
    },
    "reviewers": {
      "items": {
        "type": "string"
      },
      "title": "Reviewers",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "disputed",
        "rejected",
        "superseded"
      ],
      "title": "Status",
      "type": "string"
    },
    "target_id": {
      "title": "Target Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "created_by",
    "created_at",
    "source_id",
    "target_id",
    "relation_class",
    "relation_type",
    "status",
    "asserted_by",
    "asserted_at",
    "rationale"
  ],
  "title": "Relation",
  "type": "object"
}
