{
  "additionalProperties": false,
  "properties": {
    "contributors": {
      "items": {
        "type": "string"
      },
      "title": "Contributors",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "pattern": "^[a-z]+:[A-Za-z0-9_.-]+$",
      "title": "Created By",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "question": {
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "minLength": 1,
      "title": "Scope",
      "type": "string"
    },
    "status": {
      "enum": [
        "open",
        "active",
        "partially_resolved",
        "resolved",
        "blocked",
        "superseded"
      ],
      "title": "Status",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "id",
    "created_by",
    "created_at",
    "title",
    "question",
    "rationale",
    "scope",
    "status"
  ],
  "title": "Question",
  "type": "object"
}
