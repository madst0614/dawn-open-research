{
  "additionalProperties": false,
  "properties": {
    "artifact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Artifact Ids",
      "type": "array"
    },
    "contributors": {
      "items": {
        "type": "string"
      },
      "title": "Contributors",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "pattern": "^[a-z]+:[A-Za-z0-9_.-]+$",
      "title": "Created By",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "object_ids": {
      "items": {
        "type": "string"
      },
      "title": "Object Ids",
      "type": "array"
    },
    "research_revision": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Research Revision",
      "type": "string"
    },
    "run_ids": {
      "items": {
        "type": "string"
      },
      "title": "Run Ids",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "draft",
        "released"
      ],
      "title": "Status",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "id",
    "created_by",
    "created_at",
    "title",
    "research_revision",
    "object_ids",
    "run_ids",
    "artifact_ids",
    "status"
  ],
  "title": "PublicationManifest",
  "type": "object"
}
